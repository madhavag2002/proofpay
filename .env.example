# Copy to .env and fill in. Never commit .env.
# Keep comments on their own lines: anything after "=" is part of the value.

# mock = no PayPal calls; live = PayPal sandbox
PAYPAL_MODE=mock
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ALLOW_UNVERIFIED_WEBHOOKS=false
# How to start PayPal's MCP server (needs Node.js 18+)
PAYPAL_MCP_COMMAND=npx -y @paypal/mcp --tools=all

# mock = canned drafts; live = OpenAI
AI_MODE=mock
OPENAI_API_KEY=
AI_MODEL=

SELLER_NAME=Agra Marble Crafts
SELLER_PASSWORD=

DB_URL=
DB_USER=
DB_PASSWORD=

SANDBOX_BUYER_EMAIL=